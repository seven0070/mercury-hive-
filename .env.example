# Mercury Hive Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# PostgreSQL - Admin (migration role)
POSTGRES_ADMIN_PASSWORD=

# PostgreSQL - Runtime (application role, narrow privileges)
POSTGRES_RUNTIME_PASSWORD=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=mercury-hive
JWT_AUDIENCE=mercury-hive-api
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_HOURS=24
JWT_SESSION_DAYS=7

# Constitution
CONSTITUTION_PATH=policies/constitution.yaml

# Application
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
